generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  clerkId             String               @unique
  email               String               @unique
  fullName            String
  role                Role                 @default(PATIENT)
  subscriptionStatus  SubscriptionStatus   @default(FREE)
  stripeCustomerId    String?
  stripeSubId         String?
  referralSlug        String?
  referralCode        String?              @unique
  referredById        String?
  physicianId         String?
  isVerified          Boolean              @default(false)
  npiNumber           String?
  researchConsent     Boolean              @default(false)
  consentDate         DateTime?
  consentVersion      String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  /// Set when this identity row has entered its terminal ANONYMIZED state.
  ///
  /// Erasure anonymizes this row in place. It never deletes it, because `User`
  /// is the cascade root for ten clinical models — deleting it would destroy
  /// the longitudinal record the platform exists to keep. The row survives as
  /// an opaque subject key so those records stay attached and correctly
  /// ordered, while the person behind them is no longer identifiable.
  ///
  /// What this field does NOT assert: that external-provider erasure has
  /// completed. Clerk, Stripe and Resend are actioned through the ERASURE_*
  /// audit lifecycle, and that evidence — not this timestamp — is what shows
  /// the workflow ran to completion.
  ///
  /// Nullable with no backfill: null means "not erased", which is every
  /// existing row. Nothing reads this field yet. Surface exclusion (filtering
  /// erased subjects out of physician-facing queries) is R2-CF1 and MUST land
  /// before any anonymization is actually executed — an anonymized row that
  /// still answers a roster query would present as a nameless patient the
  /// physician believes they are supervising.
  erasedAt            DateTime?
  assessments         Assessment[]
  muscleScores        MuscleScore[]
  notifications       Notification[]
  physicianOnboarding PhysicianOnboarding?
  physicianReviews    PhysicianReview[]
  progressLogs        ProgressLog[]
  protocolPlans       ProtocolPlan[]
  shareCards          ShareCard[]
  referredBy          User?                @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]               @relation("Referrals")
  /// The patient's treating physician. SetNull, never Cascade: deleting a
  /// physician must never delete their patients, and must never leave a patient
  /// pointing at a row that no longer exists.
  ///
  /// `physicianId` carried no foreign key until Phase 1D-R2A, so a deleted
  /// physician left a dangling value behind. Both re-linking guards test the
  /// value's PRESENCE rather than its resolvability — `referral/link` skips the
  /// write on `if (!patient.physicianId)` and `accept-patient` 409s on any
  /// non-null mismatch — so a stranded patient could never be linked to a new
  /// physician again, while their report still read "Shared with your
  /// physician". Nulling the link at the database level is what makes those
  /// existing guards correct rather than something a future delete path has to
  /// remember.
  ///
  /// Becoming unlinked is the whole intent: the patient returns to the state a
  /// newly registered patient occupies and waits for a deliberate new link.
  /// This is NOT a transfer of care and must never be built into one here.
  physician           User?                @relation("PatientPhysician", fields: [physicianId], references: [id], onDelete: SetNull)
  patients            User[]               @relation("PatientPhysician")
  profile             UserProfile?
  weeklyCheckins      WeeklyCheckin[]
}

model PhysicianProfile {
  id            String   @id @default(cuid())
  slug          String   @unique
  displayName   String
  clinicName    String?
  specialty     String?
  startSheetUrl String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Human-readable code shared with patients: e.g. DR-OKPALA-472
  /// Patients enter this during onboarding to link their account.
  referralCode  String?  @unique
}

model UserProfile {
  id              String        @id @default(cuid())
  userId          String        @unique
  age             Int
  sex             Sex
  heightCm        Float
  weightKg        Float
  goalWeightKg    Float?
  activityLevel   ActivityLevel
  glp1Medication  String
  glp1DoseMg      Float
  glp1Stage       Glp1Stage
  treatmentStart  DateTime
  baselineProtein Float?
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Assessment {
  id              String           @id @default(cuid())
  userId          String
  assessmentDate  DateTime         @default(now())
  weightKg        Float
  proteinGrams    Float
  exerciseDaysWk  Int
  hydrationLitres Float
  symptoms        String[]
  fatigue         Int
  nausea          Int
  muscleWeakness  Int
  score           Float
  riskBand        RiskBand
  createdAt       DateTime         @default(now())
  /// Hours of sleep reported at assessment time
  sleepHours      Float?
  /// 1 (Very poor) – 5 (Excellent) — self-reported sleep quality
  sleepQuality    Int?
  /// Derived recovery status: 'optimal' | 'impaired' | 'critical'
  recoveryStatus  String?
  /// Hand-grip dynamometer reading in kg — used for grip-velocity triage
  gripStrengthKg  Float?
  /// GLP-1 treatment stage captured at assessment time: INITIATION | DOSE_ESCALATION | MAINTENANCE | DISCONTINUATION
  glp1Stage       String?
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  muscleScore     MuscleScore?
  physicianReview PhysicianReview?
  protocolPlan    ProtocolPlan?
}

model MuscleScore {
  id                        String     @id @default(cuid())
  userId                    String
  assessmentId              String     @unique
  score                     Float
  riskBand                  RiskBand
  leanLossEstPct            Float
  proteinTargetG            Float
  explanation               String
  generatedAt               DateTime   @default(now())
  /// Lower-bound protein target (activity-adjusted clinical floor)
  proteinStandardG          Float?
  /// Temporary step-down protein target for moderate/severe GI symptoms
  proteinStepTargetG        Int?
  /// Explains the floor/step distinction and when full floor resumes
  stepRationale             String?
  /// GI severity classification: none | mild | moderate | severe
  giSeverity                String?
  /// Estimated lean mass loss velocity derived from leanLossEstPct
  leanVelocityPct           Float?
  /// Lean velocity flag: insufficient_data | stable | concerning | critical_review
  leanVelocityFlag          String?
  /// GLP-1 stage multiplier applied to score (1.0 = no stage pressure)
  stageMultiplierApplied    Float?
  /// Floor-based protein adherence at assessment time: (most recent WeeklyCheckin.avgProteinG / proteinStandardG) × 100
  /// Uses Clinical Protein Floor as denominator — not the aggressive target — for accurate Level 3 tripwire evaluation.
  recentProteinAdherencePct Float?
  assessment                Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user                      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProtocolPlan {
  id               String     @id @default(cuid())
  userId           String
  assessmentId     String     @unique
  proteinTargetG   Float
  proteinSources   String[]
  supplementation  String[]
  trainingPlan     String
  hydrationTarget  Float
  electrolyteNotes String
  giGuidance       String
  createdAt        DateTime   @default(now())
  assessment       Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProgressLog {
  id              String   @id @default(cuid())
  userId          String
  logDate         DateTime @default(now())
  weightKg        Float
  proteinGrams    Float
  workoutsCount   Int
  hydrationLitres Float
  energyLevel     Int
  nauseaLevel     Int
  notes           String?
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WeeklyCheckin {
  id                String    @id @default(cuid())
  userId            String
  weekStart         DateTime
  weekEnd           DateTime
  avgWeightKg       Float?
  avgProteinG       Float?
  totalWorkouts     Int?
  avgHydration      Float?
  scoreDelta        Float?
  proteinAdherence  Float?
  exerciseAdherence Float?
  highlights        String[]
  recommendations   String[]
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  /// 1 (Very low) – 5 (Excellent) — self-reported from the weekly check-in form
  energyLevel       Int?
  /// 1 (None) – 5 (Severe) — self-reported from the weekly check-in form
  nauseaLevel       Int?
  /// Hours of sleep reported for the check-in week
  sleepHours        Float?
  /// 1 (Very poor) – 5 (Excellent) — self-reported sleep quality
  sleepQuality      Int?
  /// Derived recovery status: 'optimal' | 'impaired' | 'critical'
  recoveryStatus    String?
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// A patient-initiated, unauthenticated read link to their own clinical summary.
///
/// The token is a BEARER CREDENTIAL, not an identifier. Anyone holding the URL
/// reads the record, so its lifetime is bounded in two independent ways:
/// `expiresAt` (30 days absolute from creation — never sliding, because a link
/// that renews on every open would never expire at all) and `revokedAt`, which
/// the owning patient controls.
///
/// `shareToken` carries no `@default`. There is exactly one create site, and
/// removing the default makes it a compile error for a future one to mint a
/// token without choosing its entropy — the previous `cuid()` default was a
/// collision-resistant identifier being used as a secret.
///
/// `expiresAt` is nullable so enforcement and backfill stay independent: a
/// legacy row reads as non-expiring until the transition backfill stamps it,
/// so a partial backfill degrades to today's behaviour rather than locking
/// patients out of their own links.
model ShareCard {
  id         String    @id @default(cuid())
  userId     String
  score      Float
  riskBand   RiskBand
  imageUrl   String?
  shareToken String    @unique
  createdAt  DateTime  @default(now())
  /// Absolute expiry. Null = legacy row, pending the transition backfill.
  expiresAt  DateTime?
  /// Set by the owning patient. Closes the bearer channel; never unlinks a
  /// treating physician, who holds authenticated access independently.
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model ReferralInvite {
  id           String    @id @default(cuid())
  token        String    @unique @default(cuid())
  createdById  String
  redeemedById String?   @unique
  expiresAt    DateTime
  redeemedAt   DateTime?
  createdAt    DateTime  @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  subject   String
  body      String
  sentAt    DateTime?
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PhysicianReview {
  id                String     @id @default(cuid())
  assessmentId      String     @unique
  userId            String
  overallImpression String?
  followUpDays      Int?
  note              String?
  reviewedAt        DateTime
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  assessment        Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user              User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tracks cumulative physician review time per patient per billing month.
// Used to determine CPT 99470 eligibility (≥ 10 minutes of documented review).
model PhysicianReviewSession {
  id                String   @id @default(cuid())
  physicianId       String
  patientId         String
  billingMonth      String // "YYYY-MM"
  cumulativeSeconds Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([physicianId, patientId, billingMonth])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
}

model PhysicianOnboarding {
  id            String   @id @default(cuid())
  userId        String   @unique
  country       String
  specialty     String?
  licenseNumber String?
  submittedAt   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PhysicianApplication {
  id               String    @id @default(cuid())
  name             String
  email            String    @unique
  country          String
  specialty        String
  license          String?
  npi              String?
  status           String    @default("PENDING")
  submittedAt      DateTime  @default(now())
  reviewedAt       DateTime?
  reviewNote       String?
  adminToken       String?   @unique
  adminTokenExpiry DateTime?
  clerkUserId      String?
}

model StartSheetProtocol {
  id                  String   @id @default(cuid())
  physicianClerkId    String
  patientName         String
  patientEmail        String
  weightKg            Float
  age                 Int
  glp1Agent           String
  riskLevel           String
  proteinTarget       Float
  hydrationTarget     Float
  resistanceFrequency String
  supplements         String[]
  ermEnabled          Boolean  @default(false)
  physicianNotes      String?  @default("")
  createdAt           DateTime @default(now())
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  userId    String?
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())
}

model PreloadedAssessment {
  id           String   @id @default(cuid())
  physicianId  String
  patientName  String?
  patientEmail String?
  payload      Json
  used         Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

/// Abuse-control state for the two public, unauthenticated email routes
/// (/api/protocol-email, /api/email-capture). Security control only.
///
/// One row per send ATTEMPT, recorded before the provider is invoked, so the
/// limit governs mail MyoGuard is asked to originate — not just successful
/// deliveries. Append-only rows (rather than a counter) are what make the
/// 24-hour ceiling a true rolling window rather than a resetting one.
///
/// Deliberately holds no plaintext address, no name, no IP, no user id and no
/// clinical value — `recipientKey` is HMAC-SHA256(normalised email) and is not
/// reversible without the server secret.
///
/// Rows are disposable. Every request that reaches this table also runs a
/// bounded delete of rows older than the enforcement window, so the table
/// cannot accumulate while traffic continues and never becomes durable
/// anonymous visitor history. With no traffic at all, expired rows simply wait
/// for the next request — there is no scheduled job.
model EmailSendAttempt {
  id           String   @id @default(cuid())
  recipientKey String
  createdAt    DateTime @default(now())

  @@index([recipientKey, createdAt])
}

/// Tracks a patient's invitation to a physician via a shared report link.
/// Created when a physician registers or accepts from a /report/[token] CTA.
/// shareToken refs ShareCard.shareToken; patientUserId / claimedByUserId ref User.id
/// — plain scalars (zero-touch on existing models).
model PhysicianPatientInvitation {
  id              String   @id @default(cuid())
  shareToken      String
  patientUserId   String
  status          String   @default("PENDING") // PENDING | ACCEPTED | EXPIRED
  claimedByUserId String?
  createdAt       DateTime @default(now())
  expiresAt       DateTime

  @@index([shareToken])
  @@index([patientUserId])
  @@index([claimedByUserId])
}

enum Role {
  PATIENT
  PHYSICIAN
  ADMIN
  PHYSICIAN_PENDING
}

enum Sex {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ActivityLevel {
  SEDENTARY
  LIGHTLY_ACTIVE
  MODERATELY_ACTIVE
  VERY_ACTIVE
}

enum Glp1Stage {
  INITIATION
  DOSE_ESCALATION
  MAINTENANCE
  DISCONTINUING
}

enum RiskBand {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum SubscriptionStatus {
  FREE
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum NotificationType {
  WEEKLY_REMINDER
  REPORT_READY
  PAYMENT_CONFIRMED
  WELCOME
  PHYSICIAN_REVIEW
  LONGITUDINAL_SUMMARY
}

// ─── Observational Study Infrastructure ────────────────────────────────────
// Phase: Research-Ready Architecture
// All models below are additive — no existing tables or enums are modified.
//
// Relation strategy: references to existing models (User, Assessment) use plain
// scalar String fields with no @relation directive. This preserves zero-touch on
// existing clinical models and passes prisma validate without back-relations.
// Application code must verify existence of referenced IDs before writes.
//
// Terminology rules (non-negotiable, CLAUDE.md):
//   "Sarcopenia Risk Index (SRI)" — never "calculator", never bare "score"
//   "generate" / "generated" — never "calculate" / "calculated"
//   sriScore — internal research field; never exposed in UI; never sent to PostHog
//   Export column label: "sri_value_internal" in CSV / statistical output files
// ───────────────────────────────────────────────────────────────────────────

/// Lifecycle state of a named observational study.
enum StudyStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

/// Lifecycle state of a patient's enrollment in a specific study.
enum EnrollmentStatus {
  ACTIVE
  WITHDRAWN
  COMPLETED
}

/// Structured event types for the research audit trail.
/// AuditLog (existing) handles system/compliance events.
/// StudyEventLog handles research workflow milestones.
enum StudyEventType {
  ENROLLMENT
  REASSESSMENT
  PROTOCOL_MODIFICATION
  PHYSICIAN_REVIEW
  ADHERENCE_CHECKPOINT
  WITHDRAWAL
}

/// A named physician-led observational study.
/// Anchors cohort grouping, enrollment management, and research event logging.
model Study {
  id          String      @id @default(cuid())
  title       String
  /// URL-safe unique identifier — e.g., "glp1-sarcopenia-2026".
  slug        String      @unique
  description String?
  status      StudyStatus @default(DRAFT)

  /// User.id of the creating physician.
  /// Plain scalar — no @relation (zero-touch on existing User model).
  /// Always User.id — never clerkId, referralSlug, referralCode, or physicianClerkId.
  /// Application must verify: (a) User exists, (b) User.role = PHYSICIAN.
  createdById String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments StudyEnrollment[]
  eventLog    StudyEventLog[]

  @@index([createdById])
  @@index([status])
}

/// Links a patient to a named observational study under a specific physician.
/// researchParticipantId is the sole export-safe patient identifier.
/// patientId is internal — excluded from all research exports and publication.
model StudyEnrollment {
  id      String @id @default(cuid())
  studyId String
  study   Study  @relation(fields: [studyId], references: [id])

  /// User.id of the enrolled patient.
  /// Plain scalar — no @relation (zero-touch on existing User model).
  /// NEVER included in research exports or publication datasets.
  /// Application must verify User exists and User.researchConsent = true.
  patientId String

  /// User.id of the responsible physician.
  /// Plain scalar — no @relation (zero-touch on existing User model).
  /// Always User.id — never clerkId, referralSlug, referralCode, or physicianClerkId.
  /// Application must verify User exists and User.role = PHYSICIAN.
  physicianId String

  enrolledAt     DateTime         @default(now())
  /// Stamped when the patient's StudyConsent record is first created.
  consentedAt    DateTime?
  status         EnrollmentStatus @default(ACTIVE)
  /// Set when status transitions to WITHDRAWN. Previously collected snapshots are preserved.
  withdrawalDate DateTime?

  /// Optional free-form cohort segmentation label within a study.
  /// Examples: "GLP-1 Initiation", "Dose Escalation Q3-2026"
  cohortLabel String?

  /// UUID v4 — the sole patient identifier in all research exports and publications.
  /// Generated at enrollment; never updated. Non-sequential; non-reversible to patientId.
  /// Compatible with R, SPSS, Python, and CSV statistical workflows.
  researchParticipantId String @unique @default(uuid())

  consents  StudyConsent[]
  snapshots AssessmentSnapshot[]
  eventLog  StudyEventLog[]

  /// Prevents double-enrollment of the same patient in the same study.
  @@unique([studyId, patientId])
  @@index([patientId])
  @@index([physicianId])
  @@index([studyId, status])
}

/// Records a patient's data-use consent for a specific study enrollment.
/// Multiple records per enrollment are allowed — operative consent is the latest signedAt.
/// Does not replace User.researchConsent (general data-use prerequisite).
///
/// Required UI positioning: "MyoGuard Protocol is a physician-led Clinical Decision
/// Support (CDS) platform. Participation in observational data collection is voluntary
/// and does not affect your clinical care."
model StudyConsent {
  id           String          @id @default(cuid())
  enrollmentId String
  enrollment   StudyEnrollment @relation(fields: [enrollmentId], references: [id])

  /// Semantic version of the consent text at signing time — e.g., "1.0", "1.1".
  /// Application gate compares against minimum required version.
  /// Null User.consentVersion is treated as "0.0" in application gate logic only.
  consentVersion String

  /// Full verbatim text of the consent document at signing time.
  /// Immutable after creation — legal record of what the patient agreed to.
  consentTextSnapshot String

  /// Optional IP address for consent provenance. Excluded from all research exports.
  ipAddress String?

  signedAt DateTime @default(now())

  @@index([enrollmentId])
}

/// Immutable research-safe snapshot of a clinical assessment at point-in-time capture.
/// Created non-blocking (fire-and-forget) after Assessment creation when the patient
/// has an ACTIVE StudyEnrollment with a valid operative StudyConsent.
/// Assessment creation always succeeds even if snapshot creation fails.
///
/// Immutability contract: records are NEVER updated after creation.
/// Corrections require a new Assessment (new snapshot) with a PROTOCOL_MODIFICATION
/// entry in StudyEventLog documenting the reason.
///
/// sriScore: internal research value only.
///   1. Never surfaced in patient-facing or physician-facing UI.
///   2. Never transmitted to PostHog or any external analytics provider.
///   3. Export column header must be "sri_value_internal".
model AssessmentSnapshot {
  id String @id @default(cuid())

  /// Assessment.id of the source clinical record.
  /// Plain scalar — no @relation (zero-touch on existing Assessment model).
  /// Application must verify Assessment exists before snapshot creation.
  assessmentId String

  /// Required: every snapshot belongs to an active StudyEnrollment.
  /// Non-nullable — no orphan/context-free snapshots in this phase.
  enrollmentId String
  enrollment   StudyEnrollment @relation(fields: [enrollmentId], references: [id])

  /// SRI risk band at snapshot time.
  sriBand RiskBand

  /// SRI numeric output (0–100) at snapshot time. Internal research value only.
  /// Used for regression, trajectory, cohort means, and SD in statistical analysis.
  /// See immutability contract above for exposure rules.
  sriScore Float

  /// Prescribed protein target (g/day) from MuscleScore at snapshot time.
  proteinTargetG Float

  /// Prescribed hydration target (litres/day) from ProtocolPlan at snapshot time.
  hydrationTargetL Float

  /// Patient activity status at assessment time. Stored as String to preserve
  /// historical value if ActivityLevel enum changes in future.
  activityStatus String

  /// Symptom array at snapshot time. Structured codes only — no free-text PHI.
  symptoms Json

  /// GI tolerance from MuscleScore.giSeverity: none | mild | moderate | severe
  giTolerance String?

  /// Self-reported sleep quality (1 = Very poor, 5 = Excellent).
  sleepQuality Int?

  /// Hand-grip dynamometer reading (kg). Sparse — not required at assessment time.
  gripStrengthKg Float?

  /// GLP-1 treatment stage at assessment time. Stored as String to preserve
  /// historical value if Glp1Stage enum changes in future.
  glp1Stage String?

  /// Patient weight (kg) at assessment time.
  /// Quasi-identifier: export layer must bucket (e.g., 5 kg bands) in publication
  /// datasets when combined with age and sex to reduce re-identification risk.
  weightKg Float

  /// Timestamp of snapshot creation. May differ from Assessment.assessmentDate
  /// if snapshot creation is delayed in a fire-and-forget retry scenario.
  snapshotDate DateTime @default(now())

  /// One snapshot per (assessment, enrollment) pair. Both fields non-nullable:
  /// constraint is unambiguous with no NULL edge cases.
  @@unique([assessmentId, enrollmentId])
  @@index([enrollmentId])
  @@index([assessmentId])
}

/// Structured research audit trail for observational study milestones.
/// Distinct from AuditLog (system/compliance events).
/// Append-only by convention: no updates, no deletes.
///
/// eventData Json key naming (non-negotiable):
///   "sri_band" not "score" | "sri_value_internal" not "sriScore" in event payloads
///   "generated" not "calculated" | no PHI values (no names, emails, direct IDs)
model StudyEventLog {
  id      String @id @default(cuid())
  studyId String
  study   Study  @relation(fields: [studyId], references: [id])

  /// Nullable: supports study-level events (e.g., study status change) without
  /// a specific enrollment context.
  enrollmentId String?
  enrollment   StudyEnrollment? @relation(fields: [enrollmentId], references: [id])

  /// Internal patient identifier for physician-facing audit queries.
  /// Plain scalar — no @relation (zero-touch on existing User model).
  /// NEVER included in research exports or publication datasets.
  patientId String?

  eventType StudyEventType

  /// Structured event payload — no PHI. Per-eventType key conventions:
  ///   ENROLLMENT            → { cohort_label, consent_version }
  ///   REASSESSMENT          → { sri_band, sri_value_internal, interval_days }
  ///   PROTOCOL_MODIFICATION → { field_modified, reason }
  ///   PHYSICIAN_REVIEW      → { overall_impression, follow_up_days }
  ///   ADHERENCE_CHECKPOINT  → { protein_adherence, exercise_adherence, recovery_status }
  ///   WITHDRAWAL            → { reason, initiated_by }
  eventData Json?

  recordedAt DateTime @default(now())

  /// User.id of the recording actor (physician or system).
  /// Plain scalar — no @relation (zero-touch on existing User model).
  /// Always User.id — never clerkId.
  recordedBy String

  @@index([studyId])
  @@index([enrollmentId])
  @@index([studyId, eventType])
  @@index([recordedAt])
}

// ─── Communications Governance Foundation ───────────────────────────────────
// Phase: 1D-C3A — additive, behaviour-neutral data foundation.
//
// Nothing in the application reads or writes these models yet. Enforcement
// (canSend), the unsubscribe endpoint, /settings and the Resend webhook are
// later, separately authorised phases. Every table below ships empty and stays
// empty: this phase creates no preference, consent, suppression or event state
// for any existing user, and assigns no default to anyone.
//
// Relation strategy: references to EXISTING models (User, Notification) use
// plain scalar String fields with no @relation, matching the Observational
// Study block above. This keeps the change zero-touch on existing clinical
// models. Relations WITHIN this block are real relations, because both sides
// are new — and their delete behaviour is chosen so that evidence survives:
// deleting a CommunicationRecipient must never erase the record that someone
// asked not to be contacted.
//
// Identity: `recipientKey` is a keyed HMAC of the normalised email address —
// the same construction EmailSendAttempt.recipientKey uses, but derived under
// a SEPARATE, dedicated secret. The throttle's rows are swept on a 24-hour
// window and its secret may be rotated on that assumption; this keyspace must
// be permanent, so the two must not share key material. Derivation is NOT
// implemented in this phase. `keyVersion` exists so the secret can later be
// rotated without orphaning suppression rows — a lost or silently rotated key
// would make every suppression unmatchable.
//
// Data minimisation (non-negotiable): no rendered email bodies, no subject
// lines, and no clinical values — no SRI value, risk band, symptoms,
// medication or dose — anywhere in this block. CommunicationEvent REFERENCES
// clinical and workflow records by id; it never duplicates their contents.
// ────────────────────────────────────────────────────────────────────────────

/// Founder-approved communication taxonomy (Phase 1D-C2).
/// OPERATIONAL_INTERNAL is mail to MyoGuard's own operational addresses. It is
/// NOT a recipient-consent class and must never be used to reach an external
/// recipient.
enum CommunicationClass {
  ESSENTIAL_SERVICE
  CLINICAL_CONTINUITY
  EDUCATIONAL
  MARKETING
  OPERATIONAL_INTERNAL
}

/// Delivery channel. Preference and suppression are keyed on channel as well
/// as class, so opting out of SMS cannot silently opt someone out of email.
enum CommunicationChannel {
  EMAIL
  SMS
}

/// Current projected preference state for one (recipient, channel, class).
/// NEVER_SET is distinct from UNSUBSCRIBED on purpose: "has made no choice" and
/// "has declined" are different facts, and collapsing them would destroy the
/// only signal that distinguishes them.
enum CommunicationPreferenceState {
  SUBSCRIBED
  UNSUBSCRIBED
  NEVER_SET
}

/// Append-only ledger actions.
enum CommunicationConsentAction {
  GRANT
  WITHDRAW
  ADMIN_SET
  SYSTEM_SET
}

/// Why sending to this recipient is suppressed. Reasons differ in scope and in
/// reversibility, which is why a single boolean is insufficient.
enum CommunicationSuppressionReason {
  RECIPIENT_UNSUBSCRIBE
  HARD_BOUNCE
  SOFT_BOUNCE_REPEATED
  SPAM_COMPLAINT
  ADMIN_SUPPRESSION
  ACCOUNT_CONTACTABILITY_REVOKED
}

/// Lifecycle of one outbound communication attempt, including attempts that
/// were never sent because they were suppressed.
enum CommunicationState {
  REQUESTED
  SUPPRESSED
  SENT
  /// Provider accepted the message, attempted delivery, and is retrying. Added
  /// in Phase 1D-C3D because Resend emits `email.delivery_delayed` as a
  /// distinct event: without this member a deferred message would sit in SENT,
  /// indistinguishable from one the provider has said nothing further about,
  /// and the (state, requestedAt) reconciliation index could not tell "still
  /// being retried" from "silently lost".
  DELAYED
  DELIVERED
  BOUNCED_HARD
  BOUNCED_SOFT
  COMPLAINED
  FAILED
}

/// A contactable communications identity.
///
/// Created ONLY where a durable relationship legitimately exists — an account,
/// or an affirmative subscription. Deliberately NOT created by one-shot SRI /
/// protocol delivery: manufacturing a plaintext row for every anonymous visitor
/// would create the marketing list the product does not have today.
///
/// This phase populates nothing. No row is created from existing User records.
model CommunicationRecipient {
  id String @id @default(cuid())

  /// Keyed HMAC of the normalised (trimmed, lowercased) email address.
  /// Derivation is implemented in a later phase — see the block header.
  recipientKey String @unique

  /// Which generation of the identity secret produced `recipientKey`.
  keyVersion Int @default(1)

  /// Normalised plaintext address. Held here — and only here — because an
  /// ongoing relationship requires being able to actually send.
  email String @unique

  /// User.id when the recipient also holds an account.
  /// Plain scalar — no @relation (zero-touch on existing User model).
  /// Nullable: anonymous subscribers are first-class recipients.
  userId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preferences CommunicationPreference[]

  /// Back-relations for the optional, non-cascading links below.
  consentEvents CommunicationConsentEvent[]
  suppressions  CommunicationSuppression[]
  events        CommunicationEvent[]

  /// Resolving "which preferences does this signed-in user hold?" on the future
  /// authenticated preference surface.
  @@index([userId])
}

/// Current preference state — a PROJECTION, not the source of truth.
///
/// CommunicationConsentEvent is authoritative; this table exists so the future
/// send-time check is a single indexed lookup rather than a ledger replay. It
/// must be rebuildable from the ledger, and that property is the audit control.
model CommunicationPreference {
  id String @id @default(cuid())

  recipientId String
  recipient   CommunicationRecipient @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  channel            CommunicationChannel
  communicationClass CommunicationClass
  state              CommunicationPreferenceState @default(NEVER_SET)

  /// The ledger entry that established the current state. Restrict, not
  /// SetNull: the evidence for a live preference must not be deletable while
  /// the preference still points at it.
  lastEventId String?
  lastEvent   CommunicationConsentEvent? @relation(fields: [lastEventId], references: [id], onDelete: Restrict)

  updatedAt DateTime @updatedAt

  /// One preference per recipient per channel per class. Also serves the
  /// send-time lookup by leftmost prefix, so no separate index is needed.
  @@unique([recipientId, channel, communicationClass])
}

/// Append-only evidence ledger for grants, withdrawals and explicit changes.
///
/// Rows are never updated and never deleted — enforced by application logic in
/// a later phase; the schema is shaped so that invariant is possible to hold.
/// Keyed by `recipientKey` rather than by relation so the history survives
/// deletion of the plaintext recipient.
///
/// Must never contain clinical data, free-text clinical content, or rendered
/// email bodies.
model CommunicationConsentEvent {
  id String @id @default(cuid())

  /// Pseudonymous identity — present even when `recipientId` is null or has
  /// been detached.
  recipientKey String
  keyVersion   Int    @default(1)

  /// SetNull, never Cascade: removing the recipient must not erase the record
  /// of what they consented to or withdrew.
  recipientId String?
  recipient   CommunicationRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  channel            CommunicationChannel
  communicationClass CommunicationClass
  action             CommunicationConsentAction

  occurredAt DateTime @default(now())

  /// Where the action was taken. Controlled vocabulary maintained in
  /// application code rather than an enum: the surfaces this will name do not
  /// exist yet, and inventing enum values for unbuilt pages would be guesswork.
  sourceSurface String

  /// Who acted. Documented vocabulary: SELF | ADMIN | SYSTEM.
  /// Same status-as-documented-String convention as PhysicianApplication.status.
  actorType String

  /// User.id of the acting admin when actorType = ADMIN.
  /// Plain scalar — no @relation (zero-touch on existing User model).
  actorId String?

  /// The exact wording shown at the time, where a surface presented any.
  /// Restrict: wording that consent evidence points at must not be deletable.
  wordingId String?
  wording   ConsentWording? @relation(fields: [wordingId], references: [id], onDelete: Restrict)

  /// Minimal structured provenance only. Never clinical values, never a
  /// rendered body, never free-text clinical content.
  evidence Json?

  establishedPreferences CommunicationPreference[]

  /// Answers "when did this person consent, and what happened after?" — filter
  /// and sort are served by the one composite.
  @@index([recipientKey, occurredAt])
}

/// Immutable, versioned registry of the exact consent wording presented.
///
/// Rows are write-once. Without this, "what did they actually agree to?" is
/// unanswerable for every consent collected before it existed. Mirrors the
/// intent of StudyConsent.consentTextSnapshot on the research side.
model ConsentWording {
  id String @id @default(cuid())

  /// The capture surface this wording belongs to.
  surface String

  /// Semantic version of the text for that surface — e.g. "1.0", "1.1".
  version String

  /// Verbatim text as presented. Never edited in place; a change is a new row.
  text String

  effectiveFrom DateTime
  createdAt     DateTime @default(now())

  consentEvents CommunicationConsentEvent[]

  /// One version identity per surface — prevents two different texts claiming
  /// to be the same version of the same surface.
  @@unique([surface, version])
}

/// Class-aware, channel-aware, pseudonymous suppression.
///
/// Deliberately keyed by `recipientKey` and NOT dependent on a
/// CommunicationRecipient row, for two reasons that both matter:
///   - an address that was only ever sent a one-shot SRI email has no recipient
///     row, but a hard bounce or complaint on it must still suppress it;
///   - the suppression must survive deletion of the recipient, or deletion
///     would silently undo an unsubscribe and allow re-contact on re-import.
model CommunicationSuppression {
  id String @id @default(cuid())

  recipientKey String
  keyVersion   Int    @default(1)

  channel CommunicationChannel

  /// NULL means ALL classes. A class value scopes the suppression to that class
  /// alone — so a recipient who opted out of EDUCATIONAL still receives a
  /// requested report. Send-time queries must therefore match
  /// `communicationClass = <class> OR communicationClass IS NULL`.
  communicationClass CommunicationClass?

  reason CommunicationSuppressionReason

  /// Documented vocabulary: RECIPIENT | PROVIDER_WEBHOOK | ADMIN | SYSTEM.
  source String

  createdAt DateTime @default(now())

  /// Set only for auto-expiring suppressions (repeated soft bounce). NULL means
  /// the suppression does not lapse on its own.
  expiresAt DateTime?

  /// Set when the suppression is lifted. Rows are never deleted — a cleared
  /// suppression is still evidence.
  clearedAt DateTime?

  /// User.id of the clearing admin, where cleared by a person.
  /// Plain scalar — no @relation (zero-touch on existing User model).
  clearedBy String?

  /// Optional convenience link. SetNull, never Cascade — see the model note.
  recipientId String?
  recipient   CommunicationRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  /// The send-time suppression lookup: everything on record for this address
  /// and channel, class-filtered in the query.
  @@index([recipientKey, channel])
}

/// Durable record of one outbound communication attempt — including attempts
/// that were suppressed and never sent.
///
/// Suppression today is console-only and invisible once logs age out. This is
/// what makes a refusal to send auditable.
///
/// EXCLUDES BY DESIGN: rendered body, subject line, SRI value, risk band,
/// symptoms, medication, dose, and any free-text clinical content. Clinical and
/// workflow context is REFERENCED by id, never copied — note that
/// Notification.body already holds clinical JSON, and this model must not
/// duplicate it.
model CommunicationEvent {
  id String @id @default(cuid())

  recipientKey String
  keyVersion   Int    @default(1)

  /// SetNull, never Cascade: send history must outlive the recipient row.
  recipientId String?
  recipient   CommunicationRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  /// User.id when known. Plain scalar — no @relation (zero-touch on User).
  userId String?

  communicationClass CommunicationClass
  channel            CommunicationChannel

  /// Identifier of the template used — never the rendered output, and never the
  /// subject line, several of which are personalised.
  templateId String

  /// Documented vocabulary: RESEND | TWILIO.
  provider String

  /// Provider-side message id, stored so webhook delivery events can be joined
  /// back to this row. Unique: one provider message maps to at most one event.
  /// Postgres permits many NULLs under a unique index, so attempts that never
  /// reached a provider are unaffected.
  providerMessageId String? @unique

  requestedAt DateTime  @default(now())
  sentAt      DateTime?

  state CommunicationState @default(REQUESTED)

  /// Populated when state = SUPPRESSED because a CommunicationSuppression row
  /// applied.
  suppressionReason CommunicationSuppressionReason?

  /// Bounded governance reason code for a SUPPRESS_POLICY decision, where no
  /// suppression ROW was responsible and `suppressionReason` is therefore null.
  /// Added in Phase 1D-C3B.1: C3B recorded these to the console only, so the
  /// durable record could not distinguish "unverified recipient" from "no
  /// preference on record".
  ///
  /// Documented bounded vocabulary — the same status-as-String convention used
  /// by `source`, `actorType`, `provider` and PhysicianApplication.status:
  ///   recipient_not_verified | recipient_identity_unavailable |
  ///   no_preference_on_record | preference_never_set |
  ///   class_not_activated | deliverability_hold
  ///
  /// Never an address, never clinical content, never a provider error body.
  policyReason String?

  /// Notification.id where one exists.
  /// Plain scalar — no @relation (zero-touch on existing Notification model).
  relatedNotificationId String?

  /// Opaque reference to the originating workflow, for tracing only.
  relatedWorkflowRef String?

  /// Per-recipient send history, chronological.
  @@index([recipientKey, requestedAt])
  /// Reconciliation for the future provider webhook: find attempts sitting in a
  /// non-terminal state (e.g. SENT with no delivery event) within a time range.
  @@index([state, requestedAt])
}
